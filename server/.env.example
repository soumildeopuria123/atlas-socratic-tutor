# Copy to server/.env and edit.

# --- Database -------------------------------------------------------------
# Zero-install local development (SQLite). `npm run setup` generates the twin
# schema and seeds it.
DATABASE_URL="file:./dev.db"

# Production / PostgreSQL (the deployable prisma/schema.prisma):
# DATABASE_URL="postgresql://atlas:atlas@localhost:5432/atlas?schema=public"
# then run: npm run setup:postgres

# --- Sessions -------------------------------------------------------------
# Required. Minimum 16 characters. Generate with: openssl rand -hex 32
JWT_SECRET="replace-this-with-a-long-random-string"

# --- Server ---------------------------------------------------------------
PORT=4000
CLIENT_ORIGIN=http://localhost:3000

# --- Optional: Python AI engine (ai-engine/) ------------------------------
# When set, Atlas proxies lessons and messages to the FastAPI service and falls
# back to the local deterministic engine if it is unreachable.
# AI_ENGINE_URL=http://localhost:8000
# AI_ENGINE_TIMEOUT_MS=9000

# --- Optional: sandbox ----------------------------------------------------
# Execution is always allowed in development. In production it is refused
# unless explicitly enabled AND isolated (containers/microVMs recommended).
# SANDBOX_ALLOW=true
# SANDBOX_TIMEOUT_MS=8000
# PYTHON_BIN=python3
# CC_BIN=gcc
# CXX_BIN=g++
# JAVAC_BIN=javac

# --- Optional: demo account ----------------------------------------------
# SEED_DEMO=true
# DEMO_USERNAME=atlas_demo
# DEMO_PASSWORD=AtlasDemo123
